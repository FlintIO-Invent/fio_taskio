# Local development defaults
# src/config.py automatically loads repository-root .env, regardless of working directory.
# Exported environment variables take precedence (including DEBUG=release => False).
ENV=development
DEBUG=True
# Optional local Logistics operations without payment. Default stays disabled.
# To enable, set ENV=local, DEBUG=True and LOGISTICS_LOCAL_BILLING_BYPASS=True.
# Development/Staging and Production MUST keep this False.
LOGISTICS_LOCAL_BILLING_BYPASS=False
SECRET_KEY=clarivo-local-development-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Hosted deployments must use the exact live hostname(s).
# Example:
# ALLOWED_HOSTS=clarivo-2026-abc123.herokuapp.com,clarivo.example.com
# CSRF_TRUSTED_ORIGINS=https://clarivo-2026-abc123.herokuapp.com,https://clarivo.example.com

# Private production testing and production should use PostgreSQL.
# Prefer DATABASE_URL when available. If it is set, Django ignores the DB_* values below.
# DATABASE_URL=postgresql://taskio_user_dev:self.taskio@localhost:5432/taskio_database_dev
DB_ENGINE=django.db.backends.postgresql
DB_NAME=taskio_database_dev
DB_USER=taskio_user_dev
DB_PASSWORD=self.taskio
DB_HOST=localhost
DB_PORT=5432

# Temporary local fallback only when a PostgreSQL test database cannot be created.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/tmp/clarivo_local.sqlite3

# Optional explicit production overrides.
# If these are omitted, Clarivo defaults to secure values automatically whenever DEBUG=False.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# USE_X_FORWARDED_PROTO=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Email configuration: local development writes messages to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Local URL used when building links in local email output.
# Production must use the real deployed app URL with no trailing slash.
MOTIONMATE_PUBLIC_BASE_URL=http://localhost:8000
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=MotionMate Local <noreply@localhost>
SERVER_EMAIL=MotionMate Local <system@localhost>
MOTIONMATE_SUPPORT_EMAIL=support@localhost

# Stripe subscription billing.
# Real local Logistics checkout requires true, matching pk_test_/sk_test_ keys,
# TEST Prices and the whsec_ from Stripe CLI forwarding. SERVICE configuration
# (including its Price matrix and Portal configuration) is still required.
# Signed webhooks activate access in every environment. See docs/LOGISTICS_CHECKOUT.md.
# Never commit real Stripe secrets.
STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7

STRIPE_PRICE_STARTER_MONTHLY_USD=
STRIPE_PRICE_STARTER_YEARLY_USD=
STRIPE_PRICE_STARTER_MONTHLY_EUR=
STRIPE_PRICE_STARTER_YEARLY_EUR=

STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_PRICE_PRO_YEARLY_USD=
STRIPE_PRICE_PRO_MONTHLY_EUR=
STRIPE_PRICE_PRO_YEARLY_EUR=

STRIPE_PRICE_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_BUSINESS_YEARLY_USD=
STRIPE_PRICE_BUSINESS_MONTHLY_EUR=
STRIPE_PRICE_BUSINESS_YEARLY_EUR=

# Configure both TEST annual Prices for local EUR/USD Logistics checkout and
# positive matching regional_prices in Django Admin before activating the plan.
# Optional for SERVICE-only installations. No monthly mapping is supported.
STRIPE_PRICE_LOGISTICS_YEARLY_USD=
STRIPE_PRICE_LOGISTICS_YEARLY_EUR=

# Logistics application eligibility thresholds, NOT public plan limits.
LOGISTICS_AUTO_APPROVE_ALL=True
# Set False to restore strict eligibility review; reasons are advisory during the pilot.
LOGISTICS_RULE_VERSION=pilot-v1
LOGISTICS_AUTO_APPROVE_MONTHLY_PARCELS=1000
LOGISTICS_REVIEW_ABOVE_MONTHLY_PARCELS=5000
LOGISTICS_HIGH_RESOURCE_MONTHLY_PARCELS=10000
LOGISTICS_AUTO_APPROVE_STAFF_COUNT=10
LOGISTICS_AUTO_APPROVE_LOCATION_COUNT=1
# Internal review signals only; these do not enforce quotas or affect billing.
LOGISTICS_USAGE_APPROACHING_RATIO=0.8
# Optional event-volume review threshold; omit until operationally configured.
# LOGISTICS_MONTHLY_EVENT_REVIEW_THRESHOLD=<nonnegative integer>
# In strict mode, empty means review all territories; advisory while auto-approval is enabled.
LOGISTICS_SUPPORTED_TERRITORIES=
LOGISTICS_REGISTRATION_REQUIRED_FOR_AUTO_APPROVAL=True
# Enable pilot-only deployment checks; SERVICE checks are unchanged by default.
LOGISTICS_DEPLOYMENT_CHECKS_ENABLED=False
# Pilot/multiple-worker deployments must use the dedicated shared cache.
LOGISTICS_TRACKING_CACHE_ALIAS=default
LOGISTICS_TRACKING_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
LOGISTICS_TRACKING_CACHE_LOCATION=
# Redis example: install the logistics-cache extra, set alias=logistics_tracking,
# backend=django.core.cache.backends.redis.RedisCache, location=redis://.../1.
# Keep the same prefix and Django SECRET_KEY across workers/dynos.
LOGISTICS_TRACKING_CACHE_KEY_PREFIX=clarivo-logistics-tracking

# Production SMTP values should come from the selected transactional email provider.
# Recommended pilot provider: Postmark, unless the project owner chooses otherwise.
# Alternatives: Mailgun, SendGrid, Brevo, or Amazon SES.
# Do not use Gmail SMTP for production transactional app email.
# Verify the sending domain and configure SPF, DKIM, DMARC, and provider-required
# return-path/bounce records before enabling production delivery. Use the exact DNS
# values from the provider dashboard; do not invent DNS values in this repo.
# EMAIL_HOST and EMAIL_HOST_USER come from the provider.
# EMAIL_HOST_PASSWORD must be stored only in the staging/production environment.
# MOTIONMATE_PUBLIC_BASE_URL must be the real app URL with no trailing slash.
# MOTIONMATE_PUBLIC_BASE_URL=https://www.motionmate.net
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=MotionMate <noreply@motionmate.net>
# SERVER_EMAIL=MotionMate System <system@motionmate.net>
# MOTIONMATE_SUPPORT_EMAIL=support@motionmate.net
LOG_LEVEL=INFO
