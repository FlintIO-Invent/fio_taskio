# Local development defaults
ENV=development
DEBUG=True
SECRET_KEY=clarivo-local-development-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Prefer DATABASE_URL when available. If it is set, Django ignores the DB_* values below.
# DATABASE_URL=postgresql://taskio_user_dev:self.taskio@localhost:5432/taskio_database_dev
DB_ENGINE=django.db.backends.postgresql
DB_NAME=taskio_database_dev
DB_USER=taskio_user_dev
DB_PASSWORD=self.taskio
DB_HOST=localhost
DB_PORT=5432

# Production-only examples
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

DEFAULT_FROM_EMAIL=no-reply@clarivo.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOG_LEVEL=INFO
