# Local development defaults
ENV=development
DEBUG=True
SECRET_KEY=clarivo-local-development-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Hosted deployments must use the exact live hostname(s).
# Example:
# ALLOWED_HOSTS=clarivo-2026-abc123.herokuapp.com,clarivo.example.com
# CSRF_TRUSTED_ORIGINS=https://clarivo-2026-abc123.herokuapp.com,https://clarivo.example.com

# Private production testing and production should use PostgreSQL.
# Prefer DATABASE_URL when available. If it is set, Django ignores the DB_* values below.
# DATABASE_URL=postgresql://taskio_user_dev:self.taskio@localhost:5432/taskio_database_dev
DB_ENGINE=django.db.backends.postgresql
DB_NAME=taskio_database_dev
DB_USER=taskio_user_dev
DB_PASSWORD=self.taskio
DB_HOST=localhost
DB_PORT=5432

# Temporary local fallback only when a PostgreSQL test database cannot be created.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/tmp/clarivo_local.sqlite3

# Optional explicit production overrides.
# If these are omitted, Clarivo defaults to secure values automatically whenever DEBUG=False.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# USE_X_FORWARDED_PROTO=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Email configuration: local development writes messages to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Local URL used when building links in local email output.
# Production must use the real deployed app URL with no trailing slash.
MOTIONMATE_PUBLIC_BASE_URL=http://localhost:8000
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=MotionMate Local <noreply@localhost>
SERVER_EMAIL=MotionMate Local <system@localhost>
MOTIONMATE_SUPPORT_EMAIL=support@localhost

# Production SMTP values should come from the selected transactional email provider.
# Recommended pilot provider: Postmark, unless the project owner chooses otherwise.
# Alternatives: Mailgun, SendGrid, Brevo, or Amazon SES.
# Do not use Gmail SMTP for production transactional app email.
# Verify the sending domain and configure SPF, DKIM, DMARC, and provider-required
# return-path/bounce records before enabling production delivery. Use the exact DNS
# values from the provider dashboard; do not invent DNS values in this repo.
# EMAIL_HOST and EMAIL_HOST_USER come from the provider.
# EMAIL_HOST_PASSWORD must be stored only in the staging/production environment.
# MOTIONMATE_PUBLIC_BASE_URL must be the real app URL with no trailing slash.
# MOTIONMATE_PUBLIC_BASE_URL=https://www.motionmate.net
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=MotionMate <noreply@motionmate.net>
# SERVER_EMAIL=MotionMate System <system@motionmate.net>
# MOTIONMATE_SUPPORT_EMAIL=support@motionmate.net
LOG_LEVEL=INFO
